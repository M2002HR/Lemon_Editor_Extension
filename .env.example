# Service
SERVICE_PORT=4000
SERVICE_MAX_MARKDOWN_LENGTH=200000
SERVICE_JSON_BODY_LIMIT=300kb
SERVICE_DEFAULT_FILENAME_BASE=chatgpt-answer
SERVICE_PDF_BORDER_CONTENT_PADDING_MM=10
SERVICE_ALLOW_CHROME_EXTENSION_ORIGINS=true
SERVICE_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://chatgpt.com,https://chat.openai.com

# Extension build-time settings
EXTENSION_API_BASE_URL=http://localhost:4000
EXTENSION_FILENAME_PREFIX=chatgpt-answer
EXTENSION_PDF_BORDER_CONTENT_PADDING_MM=10
