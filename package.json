{
  "name": "md-to-pdf-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:service dev:extension",
    "dev:service": "npm run dev -w @mdpdf/service",
    "dev:extension": "npm run dev -w @mdpdf/extension",
    "build": "npm-run-all build:service build:extension",
    "build:service": "npm run build -w @mdpdf/service",
    "build:extension": "npm run build -w @mdpdf/extension",
    "test": "npm-run-all test:service test:extension",
    "test:service": "npm run test -w @mdpdf/service",
    "test:extension": "npm run test -w @mdpdf/extension",
    "lint": "eslint .",
    "typecheck": "npm-run-all typecheck:service typecheck:extension",
    "typecheck:service": "npm run typecheck -w @mdpdf/service",
    "typecheck:extension": "npm run typecheck -w @mdpdf/extension"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^22.15.21",
    "eslint": "^9.27.0",
    "globals": "^16.1.0",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.3"
  }
}
