{
  "manifest_version": 3,
  "name": "ChatGPT Markdown to PDF",
  "version": "0.1.0",
  "description": "Add a PDF button next to ChatGPT answers and download rendered PDFs from a local Markdown->PDF service.",
  "permissions": ["downloads", "storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://localhost:4000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ChatGPT Markdown to PDF"
  }
}
